{
  "name": "@marchelink/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "db:migrate": "tsx src/db/migrate.ts latest",
    "db:rollback": "tsx src/db/migrate.ts rollback",
    "db:seed": "tsx src/db/migrate.ts seed",
    "db:reset": "pnpm db:rollback && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@marchelink/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.11.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.2"
  }
}
