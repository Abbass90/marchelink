# ── MarchéLink API — Variables d'environnement ──────────────
# Copier ce fichier en `.env` et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier `.env` (secrets).

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Base de données (PostgreSQL 16) ─────────────────────────
# En prod (Render) : utiliser l'Internal Database URL fournie par Render.
DATABASE_URL=postgres://marchelink:marchelink@localhost:5432/marchelink
DATABASE_URL_TEST=postgres://marchelink:marchelink@localhost:5432/marchelink_test

# ── Auth (JWT) ──────────────────────────────────────────────
# Secrets ≥ 32 caractères, générés aléatoirement (openssl rand -hex 32).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long

# ── CORS ────────────────────────────────────────────────────
# Whitelist explicite, séparée par des virgules (jamais '*').
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# ── Assistant IA (Claude / Anthropic) ───────────────────────
# Clé API depuis https://console.anthropic.com (tu crées le compte).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle utilisé par le chatbot (surchargeable selon ton accès).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
